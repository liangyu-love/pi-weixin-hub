{
  "name": "pi-weixin-hub",
  "version": "0.5.0",
  "private": false,
  "type": "module",
  "description": "Weixin (WeChat) bridge for Pi Agent — enhanced fork of pi-weixin-cli with vision image analysis, persistent sessions, allowlist, group chat mode, and WeChat-optimized replies",
  "keywords": [
    "pi",
    "weixin",
    "wechat",
    "agent",
    "rpc",
    "bridge",
    "bot",
    "vision",
    "hub"
  ],
  "bin": {
    "pi-weixin-hub": "dist/main.js",
    "pi-weixin-cli": "dist/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/main.js",
    "prepack": "npm run build",
    "start": "node dist/main.js",
    "check": "tsc && node dist/selfcheck.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangyu-love/pi-weixin-hub.git"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode-terminal": "^0.12.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
